                    "as": "__cw"
                  },
                  {
                    "calculate": "max(4, width / 2 - (datum.__iw + datum.__dw + (datum.__cw > 0 ? 6 + datum.__cw : 0)) / 2)",
                    "as": "__ix"
                  },
                  {
                    "calculate": "datum.__ix + datum.__iw",
                    "as": "__dx"
                  },
                  {
                    "filter": "datum['deltaDirection'] == 'down'"
                  }
                ],
                "mark": {
                  "type": "point",
                  "shape": "M4.05 5.28a.5.5 0 0 0 .055.527l3.5 4.5a.5.5 0 0 0 .79 0l3.5-4.5A.5.5 0 0 0 11.5 5h-7a.5.5 0 0 0-.45.28",
                  "size": 4,
                  "filled": true,
                  "opacity": 1,
                  "strokeWidth": 0,
                  "color": {
                    "expr": "datum['deltaColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "datum.__ix"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20 + 54 - 8"
                    }
                  }
                }
              },
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  },
                  {
                    "calculate": "datum['deltaDirection'] == '' ? 0 : 16",
                    "as": "__iw"
                  },
                  {
                    "calculate": "scorecardTextWidth(datum['deltaText'], '600 12px Inter, Roboto, \\'Helvetica Neue\\', Arial, sans-serif')",
                    "as": "__dw"
                  },
                  {
                    "calculate": "0",
                    "as": "__cw"
                  },
                  {
                    "calculate": "max(4, width / 2 - (datum.__iw + datum.__dw + (datum.__cw > 0 ? 6 + datum.__cw : 0)) / 2)",
                    "as": "__ix"
                  },
                  {
                    "calculate": "datum.__ix + datum.__iw",
                    "as": "__dx"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "left",
                  "baseline": "middle",
                  "fontWeight": 600,
                  "fontSize": 12,
                  "color": {
                    "expr": "datum['deltaColor']"
                  },
                  "limit": {
                    "expr": "max(0, width - 4 - datum.__dx)"
                  },
                  "dx": {
                    "expr": "datum.__dx"
                  }
                },
                "encoding": {
                  "x": {
                    "value": 0
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20 + 54"
                    }
                  },
                  "text": {
                    "field": "deltaText"
                  }
                }
              },
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontSize": 12,
                  "color": "#5d6a85",
                  "limit": {
                    "expr": "width - 24"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20 + 34"
                    }
                  },
                  "text": {
                    "value": "USD, vs same period last year"
                  }
                }
              }
            ],
            "config": {
              "view": {
                "stroke": null
              },
              "mark": {
                "tooltip": false
              }
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "CURRENT_VALUE",
                  "labelField": "",
                  "format": "decimal",
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "decimals": 1,
                  "abbreviate": true,
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "labelEnabled": true,
                  "labelText": "USD, vs same period last year",
                  "sparklineColorMode": "polarity",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "seriesField": "",
                  "deltaField": "",
                  "comparisonSeriesValueField": ""
                },
                "intro": [
                  {
                    "signal": "__scorecard_reveal",
                    "from": 0,
                    "to": 1,
                    "rest": 1,
                    "ms": 1500,
                    "ease": "easeOut"
                  },
                  {
                    "signal": "__scorecard_pulse",
                    "from": 0,
                    "to": 1,
                    "rest": 0,
                    "ms": 770,
                    "ease": "linear"
                  }
                ]
              }
            },
            "title": ""
          },
          "datasources": [
            "ds-kpi-net-revenue"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-attainment",
          "title": "Target Attainment",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "polarity",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of target, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-attainment"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-variance",
          "title": "Variance to Target",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "width": 400,
            "height": 200,
            "padding": 0,
            "params": [
              {
                "name": "__scorecard_reveal",
                "value": 1
              },
              {
                "name": "__scorecard_pulse",
                "value": 0
              }
            ],
            "data": {
              "name": "values"
            },
            "transform": [
              {
                "calculate": "(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) ? (abs(datum['CURRENT_VALUE']) >= 1e9 ? format(datum['CURRENT_VALUE'] / 1e9, '.0~f') + 'B' : abs(datum['CURRENT_VALUE']) >= 1e6 ? format(datum['CURRENT_VALUE'] / 1e6, '.0~f') + 'M' : abs(datum['CURRENT_VALUE']) >= 1e3 ? format(datum['CURRENT_VALUE'] / 1e3, '.0~f') + 'K' : format(datum['CURRENT_VALUE'], ',.0~f')) : 'N/A'",
                "as": "bigNumberText"
              },
              {
                "calculate": "'neutral'",
                "as": "__toneKey"
              },
              {
                "calculate": "!(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) ? '#5d6a85' : ('#1e252f')",
                "as": "__numberColor"
              },
              {
                "calculate": "'neutral'",
                "as": "__chartKey"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__lineColor"
              },
              {
                "calculate": "'#3580f2'",
                "as": "__chartColor"
              }
            ],
            "layer": [
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  },
                  {
                    "filter": "datum['__chartKey'] == 'neutral'"
                  }
                ],
                "mark": {
                  "type": "area",
                  "opacity": 0.162,
                  "color": {
                    "gradient": "linear",
                    "x1": 0,
                    "y1": 0,
                    "x2": 0,
                    "y2": 1,
                    "stops": [
                      {
                        "offset": 0,
                        "color": "rgba(53, 128, 242, 1)"
                      },
                      {
                        "offset": 0.45,
                        "color": "rgba(53, 128, 242, 0.55)"
                      },
                      {
                        "offset": 1,
                        "color": "rgba(53, 128, 242, 0)"
                      }
                    ]
                  },
                  "line": false,
                  "interpolate": "monotone",
                  "tooltip": true,
                  "xOffset": {
                    "expr": "datum.__tail == 1 ? 3 : 0"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "__sx",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  },
                  "y2": {
                    "value": {
                      "expr": "height"
                    }
                  },
                  "tooltip": [
                    {
                      "field": "DS",
                      "type": "temporal",
                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  }
                ],
                "mark": {
                  "type": "line",
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "opacity": 0.36,
                  "strokeWidth": 1,
                  "strokeCap": "round",
                  "strokeJoin": "round",
                  "interpolate": "monotone",
                  "xOffset": {
                    "expr": "datum.__tail == 1 ? 3 : 0"
                  },
                  "clip": {
                    "signal": "pathShape('M-2,-2H' + (__scorecard_reveal >= 1 ? width + 2 : __scorecard_reveal * width) + 'V' + (height + 2) + 'H-2Z')"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "__sx",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__last"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "descending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__last == 1"
                  }
                ],
                "mark": {
                  "type": "point",
                  "filled": false,
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "strokeWidth": 1,
                  "clip": true,
                  "size": {
                    "expr": "__scorecard_pulse <= 0 || __scorecard_pulse >= 1 ? 0 : pow(14 * (1 + 1.6 * (1 - pow(1 - __scorecard_pulse, 2))), 2)"
                  },
                  "strokeOpacity": {
                    "expr": "__scorecard_pulse <= 0 || __scorecard_pulse >= 1 ? 0 : 1 - __scorecard_pulse"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "DS",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__last"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "descending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__last == 1"
                  }
                ],
                "mark": {
                  "type": "point",
                  "filled": true,
                  "opacity": 1,
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "size": 36,
                  "clip": true,
                  "tooltip": true
                },
                "encoding": {
                  "x": {
                    "field": "DS",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "DS",
                      "type": "temporal",
                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontWeight": "bold",
                  "fontSize": {
                    "expr": "width >= 140 ? 40 : (width >= 90 ? 24 : 14)"
                  },
                  "limit": {
                    "expr": "width - 8"
                  },
                  "color": {
                    "expr": "datum['__numberColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 12"
                    }
                  },
                  "text": {
                    "field": "bigNumberText"
                  }
                }
              },
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontSize": 12,
                  "color": "#5d6a85",
                  "limit": {
                    "expr": "width - 24"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 12 + 34"
                    }
                  },
                  "text": {
                    "value": "USD, net revenue minus target"
                  }
                }
              }
            ],
            "config": {
              "view": {
                "stroke": null
              },
              "mark": {
                "tooltip": false
              }
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "CURRENT_VALUE",
                  "labelField": "",
                  "format": "decimal",
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "decimals": 0,
                  "abbreviate": true,
                  "comparisonEnabled": false,
                  "prevColumn": "PRIOR_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "labelEnabled": true,
                  "labelText": "USD, net revenue minus target",
                  "sparklineColorMode": "threshold",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "seriesField": "",
                  "deltaField": "",
                  "comparisonSeriesValueField": "",
                  "thresholdDirection": "higher-is-better",
                  "thresholds": [
                    {
                      "slot": "alert",
                      "comparator": "lt",
                      "value": -1500000,
                      "color": "red"
                    },
                    {
                      "slot": "warn",
                      "comparator": "lt",
                      "value": 0,
                      "color": "yellow"
                    },
                    {
                      "slot": "good",
                      "comparator": "gte",
                      "value": 0,
                      "color": "green"
                    }
                  ]
                },
                "intro": [
                  {
                    "signal": "__scorecard_reveal",
                    "from": 0,
                    "to": 1,
                    "rest": 1,
                    "ms": 1500,
                    "ease": "easeOut"
                  },
                  {
                    "signal": "__scorecard_pulse",
                    "from": 0,
                    "to": 1,
                    "rest": 0,
                    "ms": 770,
                    "ease": "linear"
                  }
                ]
              }
            },
            "title": ""
          },
          "datasources": [
            "ds-kpi-variance"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-margin",
          "title": "Gross Margin",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "polarity",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of net revenue, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-margin"
          ],
          "scope": "main"
        },
        {
          "tile_id": "trend",
          "title": "Monthly Net Revenue vs Target (Drag across months to zoom and filter)",
          "type": "chart",
          "spec": {
            "transform": [
              {
                "fold": [
                  "NET_REVENUE",
                  "REVENUE_TARGET"
                ],
                "as": [
                  "SERIES",
                  "VALUE"
                ]
              },
              {
                "calculate": "datum.SERIES === 'NET_REVENUE' ? 'Net revenue' : 'Target'",
                "as": "SERIES_LABEL"
              }
            ],
            "encoding": {
              "x": {
                "field": "MONTH",
                "type": "temporal",
                "title": "Month"
              },
              "y": {
                "field": "VALUE",
                "type": "quantitative",
                "title": "USD",
                "stack": null,
                "scale": {
                  "zero": false
                },
                "axis": {
                  "format": "$,.2s"
                }
              },
              "color": {
                "field": "SERIES_LABEL",
                "type": "nominal",
                "title": null,
                "scale": {
                  "domain": [
                    "Net revenue",
                    "Target"
                  ],
                  "range": [
                    "#5B8DEF",
                    "#3E9F98"
                  ]
                }
              },
              "fillOpacity": {
                "condition": {
                  "test": "datum.SERIES === 'NET_REVENUE'",
                  "value": 0.3
                },
                "value": 0
              },
              "tooltip": [
                {
                  "field": "MONTH",
                  "type": "temporal",
                  "format": "%b %Y"
                },
                {
                  "field": "SERIES_LABEL",
                  "title": "Series"
                },
                {
                  "field": "VALUE",
                  "type": "quantitative",
                  "format": "$,.0f"
                }
              ]
            },
            "mark": {
              "type": "area",
              "interpolate": "monotone",
              "clip": true,
              "line": {
                "strokeWidth": 2.5
              },
              "point": true
            }
          },
          "datasources": [
            "ds-trend"
          ],
          "scope": "main",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "MONTH"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                },
                {
                  "scope": "heat",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                },
                {
                  "scope": "region",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "by-region",
          "title": "Variance to Target by Region (Click a Region to drill the charts below)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "bar",
                  "cornerRadiusEnd": 3
                },
                "encoding": {
                  "y": {
                    "field": "DRILL_REGION",
                    "type": "nominal",
                    "sort": "x",
                    "title": null,
                    "axis": {
                      "labelExpr": "peek(split(datum.label, ' \u203a '))",
                      "labelLimit": 180
                    }
                  },
                  "x": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "USD vs target",
                    "axis": {
                      "format": "$,.2s"
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "color": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "range": [
                        "#C8524B",
                        "#DD8459",
                        "#E2C27A",
                        "#5E8AC7",
                        "#3E9F98"
                      ],
                      "interpolate": "rgb"
                    },
                    "legend": null
                  },
                  "tooltip": [
                    {
                      "field": "LEVEL",
                      "title": "Level"
                    },
                    {
                      "field": "DRILL_REGION",
                      "title": "Path"
                    },
                    {
                      "field": "NET_REVENUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Net revenue"
                    },
                    {
                      "field": "REVENUE_TARGET",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Target"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Variance"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%",
                      "title": "Attainment"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "aggregate": [
                      {
                        "op": "min",
                        "field": "VARIANCE",
                        "as": "LO"
                      },
                      {
                        "op": "max",
                        "field": "VARIANCE",
                        "as": "HI"
                      }
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": "$,.2s",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "range": [
                        "#C8524B",
                        "#DD8459",
                        "#E2C27A",
                        "#5E8AC7",
                        "#3E9F98"
                      ],
                      "interpolate": "rgb"
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-by-region"
          ],
          "scope": "region",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "DRILL_REGION"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "DRILL_REGION"
                  ],
                  "filter": "DRILL_REGION"
                },
                {
                  "scope": "heat",
                  "fields": [
                    "DRILL_REGION"
                  ],
                  "filter": "DRILL_REGION"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "heatmap",
          "title": "Target Attainment (Click a cell to filter by Region and Segment)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "transform": [
                  {
                    "calculate": "datum.ATTAINMENT",
                    "as": "HEAT"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "min",
                        "field": "HEAT",
                        "as": "HEAT_LO"
                      },
                      {
                        "op": "max",
                        "field": "HEAT",
                        "as": "HEAT_HI"
                      }
                    ]
                  }
                ],
                "layer": [
                  {
                    "mark": {
                      "type": "rect",
                      "stroke": "black",
                      "strokeWidth": 2
                    },
                    "encoding": {
                      "color": {
                        "field": "HEAT",
                        "type": "quantitative",
                        "title": "Attainment",
                        "scale": {
                          "range": [
                            "#C8524B",
                            "#DD8459",
                            "#E2C27A",
                            "#5E8AC7",
                            "#3E9F98"
                          ],
                          "domain": [
                            0.55,
                            0.7125,
                            0.875,
                            1.0375,
                            1.2
                          ],
                          "clamp": true,
                          "interpolate": "rgb"
                        },
                        "legend": null
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "text",
                      "fontWeight": "bold"
                    },
                    "encoding": {
                      "text": {
                        "field": "ATTAINMENT",
                        "type": "quantitative",
                        "format": ".1%"
                      },
                      "color": {
                        "condition": {
                          "test": "datum.ATTAINMENT < 0.68 || datum.ATTAINMENT > 1.12",
                          "value": "white"
                        },
                        "value": "#14365d"
                      }
                    }
                  }
                ],
                "encoding": {
                  "x": {
                    "field": "SEGMENT",
                    "type": "nominal",
                    "title": null,
                    "sort": [
                      "Enterprise",
                      "Mid-market",
                      "SMB"
                    ],
                    "axis": {
                      "labelAngle": 0
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "REGION",
                    "type": "nominal",
                    "title": null
                  },
                  "tooltip": [
                    {
                      "field": "REGION"
                    },
                    {
                      "field": "SEGMENT"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "calculate": "datum.ATTAINMENT",
                    "as": "HEAT"
                  },
                  {
                    "calculate": "0.55",
                    "as": "LO"
                  },
                  {
                    "calculate": "1.2",
                    "as": "HI"
                  },
                  {
                    "aggregate": [
                      {
                        "op": "count",
                        "as": "N"
                      }
                    ],
                    "groupby": [
                      "LO",
                      "HI"
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Attainment",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": ".0%",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "range": [
                        "#C8524B",
                        "#DD8459",
                        "#E2C27A",
                        "#5E8AC7",
                        "#3E9F98"
                      ],
                      "domain": [
                        0.55,
                        0.7125,
                        0.875,
                        1.0375,
                        1.2
                      ],
                      "clamp": true,
                      "interpolate": "rgb"
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-heatmap"
          ],
          "scope": "heat",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "REGION",
                "SEGMENT"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "REGION"
                  ],
                  "filter": "REGION"
                },
                {
                  "scope": "main",
                  "fields": [
                    "SEGMENT"
                  ],
                  "filter": "SEGMENT"
                },
                {
                  "scope": "region",
                  "fields": [
                    "REGION"
                  ],
                  "filter": "REGION"
                },
                {
                  "scope": "region",
                  "fields": [
                    "SEGMENT"
                  ],
                  "filter": "SEGMENT"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "drivers",
          "title": "What Sales Ops Recorded: Variance by Driver",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "transform": [
              {
                "calculate": "abs(datum.VARIANCE)",
                "as": "ABS_VARIANCE"
              },
              {
                "calculate": "replace(replace(peek(split(datum.DRILL_DRIVER, ' \u203a ')), 'RECORDED_', ''), regexp('_','g'), '\\n') + '\\n' + format(datum.VARIANCE, '$,.2s')",
                "as": "LABEL"
              }
            ],
            "encoding": {
              "theta": {
                "field": "ABS_VARIANCE",
                "type": "quantitative",
                "stack": true
              },
              "order": {
                "field": "VARIANCE",
                "type": "quantitative",
                "sort": "ascending"
              }
            },
            "layer": [
              {
                "mark": {
                  "type": "arc",
                  "innerRadius": {
                    "expr": "min(width,height)*0.2"
                  },
                  "outerRadius": {
                    "expr": "min(width,height)*0.48"
                  },
                  "padAngle": 0.01,
                  "cornerRadius": 3
                },
                "encoding": {
                  "color": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "range": [
                        "#C8524B",
                        "#DD8459",
                        "#E2C27A",
                        "#5E8AC7",
                        "#3E9F98"
                      ],
                      "interpolate": "rgb"
                    },
                    "legend": null
                  },
                  "tooltip": [
                    {
                      "field": "LEVEL",
                      "title": "Level"
                    },
                    {
                      "field": "DRILL_DRIVER",
                      "title": "Path"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "DISCOUNTS",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "REFUNDS",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "ACCOUNTS",
                      "type": "quantitative",
                      "title": "Accounts"
                    }
                  ]
                }
              },
              {
                "mark": {
                  "type": "text",
                  "radius": {
                    "expr": "min(width,height)*0.34"
                  },
                  "fontSize": 9,
                  "fontWeight": "bold",
                  "fill": "#ffffff",
                  "lineBreak": "\n",
                  "lineHeight": 11,
                  "limit": 90
                },
                "encoding": {
                  "text": {
                    "field": "LABEL"
                  }
                }
              }
            ],
            "view": {
              "stroke": null
            }
          },
          "datasources": [
            "ds-drivers"
          ],
          "scope": "detail"
        },
        {
          "tile_id": "waterfall",
          "title": "Variance Bridge: How Each Recorded Driver Moves Us vs Target",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "layer": [
                  {
                    "mark": {
                      "type": "bar",
                      "width": {
                        "band": 0.6
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "START_VALUE",
                        "type": "quantitative",
                        "title": "USD vs target",
                        "axis": {
                          "format": "$,.2s"
                        }
                      },
                      "y2": {
                        "field": "END_VALUE"
                      },
                      "color": {
                        "field": "AMOUNT",
                        "type": "quantitative",
                        "title": "Amount",
                        "scale": {
                          "range": [
                            "#C8524B",
                            "#DD8459",
                            "#E2C27A",
                            "#5E8AC7",
                            "#3E9F98"
                          ],
                          "interpolate": "rgb"
                        },
                        "legend": null
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "rule",
                      "color": "#8a9bb0"
                    },
                    "encoding": {
                      "y": {
                        "datum": 0
                      }
                    }
                  },
                  {
                    "transform": [
                      {
                        "filter": "datum.KIND !== 'Total'"
                      }
                    ],
                    "mark": {
                      "type": "rule",
                      "strokeDash": [
                        3,
                        3
                      ],
                      "color": "#8a9bb0",
                      "xOffset": {
                        "expr": "bandwidth('x') * 0.3"
                      },
                      "x2Offset": {
                        "expr": "-bandwidth('x') * 0.3"
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "END_VALUE",
                        "type": "quantitative"
                      },
                      "x2": {
                        "field": "NEXT_STEP"
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "text",
                      "fontSize": 11,
                      "color": "#8a9bb0",
                      "dy": {
                        "expr": "datum.AMOUNT < 0 ? 10 : -8"
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "LABEL_Y",
                        "type": "quantitative"
                      },
                      "text": {
                        "field": "AMOUNT",
                        "type": "quantitative",
                        "format": "$,.3s"
                      }
                    }
                  }
                ],
                "encoding": {
                  "x": {
                    "field": "STEP",
                    "type": "nominal",
                    "title": null,
                    "sort": {
                      "field": "STEP_ORDER"
                    },
                    "axis": {
                      "labelAngle": 0,
                      "labelOverlap": false,
                      "labelLineHeight": 14,
                      "labelExpr": "[substring(datum.label, 0, indexof(datum.label, ' ')), substring(datum.label, indexof(datum.label, ' ') + 1)]"
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "STEP",
                      "title": "Step"
                    },
                    {
                      "field": "AMOUNT",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Amount"
                    },
                    {
                      "field": "END_VALUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Running variance"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "aggregate": [
                      {
                        "op": "min",
                        "field": "AMOUNT",
                        "as": "LO"
                      },
                      {
                        "op": "max",
                        "field": "AMOUNT",
                        "as": "HI"
                      }
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Amount",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": "$,.2s",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "range": [
                        "#C8524B",
                        "#DD8459",
                        "#E2C27A",
                        "#5E8AC7",
                        "#3E9F98"
                      ],
                      "interpolate": "rgb"
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-waterfall"
          ],
          "scope": "main"
        },
        {
          "tile_id": "bubble",
          "title": "Accounts: Target vs Attainment (bubble size = net revenue)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "rule",
                  "strokeDash": [
                    4,
                    4
                  ],
                  "color": "#8a9bb0"
                },
                "encoding": {
                  "y": {
                    "datum": 1
                  }
                }
              },
              {
                "mark": {
                  "type": "circle",
                  "opacity": 0.75,
                  "stroke": "white",
                  "strokeWidth": 1
                },
                "encoding": {
                  "x": {
                    "field": "REVENUE_TARGET",
                    "type": "quantitative",
                    "title": "Target (USD)",
                    "axis": {
                      "format": "$,.2s"
                    },
                    "scale": {
                      "type": "log",
                      "nice": false,
                      "padding": 48
                    }
                  },
                  "y": {
                    "field": "ATTAINMENT",
                    "type": "quantitative",
                    "title": "Attainment",
                    "axis": {
                      "format": ".0%",
                      "values": [
                        0,
                        0.5,
                        0.7,
                        0.8,
                        0.9,
                        1.0,
                        1.05
                      ],
                      "labelOverlap": false
                    },
                    "scale": {
                      "type": "pow",
                      "exponent": 4,
                      "domain": [
                        0,
                        1.07
                      ],
                      "nice": false
                    }
                  },
                  "size": {
                    "field": "NET_REVENUE",
                    "type": "quantitative",
                    "title": "Net revenue",
                    "scale": {
                      "range": [
                        20,
                        900
                      ]
                    },
                    "legend": null
                  },
                  "color": {
                    "field": "REGION",
                    "type": "nominal",
                    "title": "Region",
                    "scale": {
                      "domain": [
                        "Americas",
                        "EMEA",
                        "APAC"
                      ],
                      "range": [
                        "#5B8DEF",
                        "#4FA88A",
                        "#E3C77A"
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "CUSTOMER_NAME",
                      "title": "Account"
                    },
                    {
                      "field": "SEGMENT"
                    },
                    {
                      "field": "NET_REVENUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Net revenue"
                    },
                    {
                      "field": "REVENUE_TARGET",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Target"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%"
                    }
                  ]
                }
              }
            ]
          },
          "datasources": [
            "ds-bubble"
          ],
          "scope": "detail"
        },
        {
          "tile_id": "ask",
          "type": "text",
          "text": "### Ask Revenue Advisor\nOnce published to CoWork, use the chat box below this dashboard. Try:\n- *Why is EMEA Enterprise behind target in Q3 2026? Quantify the drivers.*\n- *Which accounts contributed most to the Q3 shortfall?*\n- *Will the renewal-delayed revenue recover in Q4?*\n- *How much of the gap is associated with discounts and refunds?*\n\nDrivers come from the `RECORDED_DRIVER` field logged by sales ops. They are recorded reasons, not inferred causes."
        },
        {
          "tile_id": "accounts",
          "title": "Account Detail (sorted by variance)",
          "type": "table",
          "spec": {
            "columns": [
              {
                "field": "CUSTOMER_NAME",
                "label": "Account"
              },
              {
                "field": "REGION",
                "label": "Region"
              },
              {
                "field": "SEGMENT",
                "label": "Segment"
              },
              {
                "field": "NET_REVENUE",
                "label": "Net revenue (USD)"
              },
              {
                "field": "REVENUE_TARGET",
                "label": "Target (USD)"
              },
              {
                "field": "VARIANCE",
                "label": "Variance (USD)"
              },
              {
                "field": "ATTAINMENT_PCT",
                "label": "Attainment %"
              },
              {
                "field": "GROSS_MARGIN_PCT",
                "label": "Gross margin %"
              },
              {
                "field": "TOP_DRIVER",
                "label": "Recorded driver"
              }
            ]
          },
          "datasources": [
            "ds-accounts"
          ],
          "scope": "detail"
        },
        {
          "tile_id": "source",
          "type": "text",
          "text": "Source: Database/Schema: `REVENUE_PULSE_DB.DASHBOARD_DEMO` | Semantic View: `REVENUE_SEMANTIC_VIEW` | Tables: `REVENUE_MONTHLY` (monthly revenue, targets, and recorded drivers), `CUSTOMERS` (region and segment), and `PRODUCTS`."
        }
      ]
    }
  ],
  "filters": {
    "MONTH": {
      "label": "Period",
      "mode": "range",
      "valueType": "DATE",
      "default_values": [
        "2026-07-01",
        "2026-09-01"
      ]
    },
    "REGION": {
      "label": "Region",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.CUSTOMERS",
        "column": "REGION"
      }
    },
    "SEGMENT": {
      "label": "Segment",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.CUSTOMERS",
        "column": "SEGMENT"
      }
    },
    "PRODUCT_NAME": {
      "label": "Product",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.PRODUCTS",
        "column": "PRODUCT_NAME"
      }
    },
    "BRUSH_MONTH": {
      "label": "Months picked on trend",
      "mode": "range",
      "valueType": "DATE",
      "default_values": []
    },
    "DRILL_REGION": {
      "label": "Drill: region path",
      "mode": "single_select",
      "valueType": "STRING",
      "default_values": [],
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.CUSTOMERS",
        "column": "REGION"
      }
    },
