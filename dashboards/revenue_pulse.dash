                        }
                      ]
                    }
                  },
                  "y2": {
                    "value": {
                      "expr": "height"
                    }
                  },
                  "tooltip": [
                    {
                      "field": "DS",
                      "type": "temporal",
                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  },
                  {
                    "filter": "datum['__chartKey'] == 'critical'"
                  }
                ],
                "mark": {
                  "type": "area",
                  "opacity": 0.162,
                  "color": {
                    "gradient": "linear",
                    "x1": 0,
                    "y1": 0,
                    "x2": 0,
                    "y2": 1,
                    "stops": [
                      {
                        "offset": 0,
                        "color": "rgba(239, 64, 94, 1)"
                      },
                      {
                        "offset": 0.45,
                        "color": "rgba(239, 64, 94, 0.55)"
                      },
                      {
                        "offset": 1,
                        "color": "rgba(239, 64, 94, 0)"
                      }
                    ]
                  },
                  "line": false,
                  "interpolate": "monotone",
                  "tooltip": true,
                  "xOffset": {
                    "expr": "datum.__tail == 1 ? 3 : 0"
                  }
                },
                "encoding": {
                  "x": {
