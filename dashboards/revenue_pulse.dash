OM cur_rows)) AND (SELECT MAX(MONTH) FROM cur_rows)\n    GROUP BY MONTH\n)\nSELECT spark.DS, 100 * DIV0NULL(spark.GP, spark.NET) AS SERIES_VALUE,\n    100 * DIV0NULL(cur.GP, cur.NET) AS CURRENT_VALUE, 100 * DIV0NULL(py.GP, py.NET) AS PRIOR_VALUE\nFROM spark CROSS JOIN cur CROSS JOIN py\nORDER BY spark.DS",
