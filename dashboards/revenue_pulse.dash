{
  "spec_version": 2,
  "spec_revision": 5,
  "version": 2,
  "title": "Revenue Pulse",
  "tabs": [
    {
      "order": 0,
      "tab_id": "default",
      "title": "Overview",
      "tiles": [
        {
          "tile_id": "header",
          "type": "text",
          "text": "# Revenue Pulse\n**Synthetic demo data** for a fictional B2B software company, complete through **2026-09-30**.\n\nNet revenue = gross revenue minus discounts and refunds. Attainment = net revenue / target. Year-over-year compares the same filtered months one year earlier. Default view: Q3 2026."
        },
        {
          "tile_id": "actions",
          "title": "Try Chart Actions",
          "type": "text",
          "text": "- **Drag** across months in **Monthly Net Revenue** to zoom and filter every tile.\n- **Click** a region bar in **Variance to Target by Region** to drill into segments, then accounts.\n- **Click** a cell in **Target Attainment** to filter the dashboard by that region and segment."
        },
        {
          "tile_id": "kpi-net-revenue",
          "title": "Net Revenue",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "width": 400,
            "height": 200,
            "padding": 0,
            "params": [
              {
                "name": "__scorecard_reveal",
                "value": 1
              },
              {
                "name": "__scorecard_pulse",
                "value": 0
              }
            ],
            "data": {
              "name": "values"
            },
            "transform": [
              {
                "calculate": "(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) ? (abs(datum['CURRENT_VALUE']) >= 1e9 ? format(datum['CURRENT_VALUE'] / 1e9, '.1~f') + 'B' : abs(datum['CURRENT_VALUE']) >= 1e6 ? format(datum['CURRENT_VALUE'] / 1e6, '.1~f') + 'M' : abs(datum['CURRENT_VALUE']) >= 1e3 ? format(datum['CURRENT_VALUE'] / 1e3, '.1~f') + 'K' : format(datum['CURRENT_VALUE'], ',.1~f')) : 'N/A'",
                "as": "bigNumberText"
              },
              {
                "calculate": "datum['PRIOR_VALUE'] == null || datum['PRIOR_VALUE'] == 0 ? null : (datum['CURRENT_VALUE'] - datum['PRIOR_VALUE']) / datum['PRIOR_VALUE'] * 100",
                "as": "__derivedDelta"
              },
              {
                "calculate": "!((isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE']))) ? '' : (((isValid(datum['PRIOR_VALUE']) && isNumber(datum['PRIOR_VALUE']))) ? ((datum['__derivedDelta'] == null ? 'N/A' : format(abs(datum['__derivedDelta']), '.1f') + '%')) : 'N/A')",
                "as": "deltaText"
              },
              {
                "calculate": "(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) && (isValid(datum['PRIOR_VALUE']) && isNumber(datum['PRIOR_VALUE'])) ? ((datum['CURRENT_VALUE'] - datum['PRIOR_VALUE']) >= 0 ? '#087959' : '#d3132f') : '#5d6a85'",
                "as": "deltaColor"
              },
              {
                "calculate": "(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) && (isValid(datum['PRIOR_VALUE']) && isNumber(datum['PRIOR_VALUE'])) ? ((datum['CURRENT_VALUE'] - datum['PRIOR_VALUE']) >= 0 ? 'up' : 'down') : ''",
                "as": "deltaDirection"
              },
              {
                "calculate": "'neutral'",
                "as": "__toneKey"
              },
              {
                "calculate": "!(isValid(datum['CURRENT_VALUE']) && isNumber(datum['CURRENT_VALUE'])) ? '#5d6a85' : ('#1e252f')",
                "as": "__numberColor"
              },
              {
                "calculate": "datum['deltaColor'] == '#087959' ? 'success' : (datum['deltaColor'] == '#d3132f' ? 'critical' : 'neutral')",
                "as": "__chartKey"
              },
              {
                "calculate": "datum['__chartKey'] == 'success' ? '#51d9ae' : (datum['__chartKey'] == 'critical' ? '#ffced0' : ('#3580f2'))",
                "as": "__lineColor"
              },
              {
                "calculate": "datum['__chartKey'] == 'success' ? '#51d9ae' : (datum['__chartKey'] == 'critical' ? '#ef405e' : ('#3580f2'))",
                "as": "__chartColor"
              }
            ],
            "layer": [
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  },
                  {
                    "filter": "datum['__chartKey'] == 'neutral'"
                  }
                ],
                "mark": {
                  "type": "area",
                  "opacity": 0.162,
                  "color": {
                    "gradient": "linear",
                    "x1": 0,
                    "y1": 0,
                    "x2": 0,
                    "y2": 1,
                    "stops": [
                      {
                        "offset": 0,
                        "color": "rgba(53, 128, 242, 1)"
                      },
                      {
                        "offset": 0.45,
                        "color": "rgba(53, 128, 242, 0.55)"
                      },
                      {
                        "offset": 1,
                        "color": "rgba(53, 128, 242, 0)"
                      }
                    ]
                  },
                  "line": false,
                  "interpolate": "monotone",
                  "tooltip": true,
                  "xOffset": {
                    "expr": "datum.__tail == 1 ? 3 : 0"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "__sx",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  },
                  "y2": {
                    "value": {
                      "expr": "height"
                    }
                  },
                  "tooltip": [
                    {
                      "field": "DS",
                      "type": "temporal",
                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  },
                  {
                    "filter": "datum['__chartKey'] == 'success'"
                  }
                ],
                "mark": {
                  "type": "area",
                  "opacity": 0.162,
                  "color": {
                    "gradient": "linear",
                    "x1": 0,
                    "y1": 0,
                    "x2": 0,
