{
  "spec_version": 2,
  "spec_revision": 5,
  "version": 2,
  "title": "Revenue Pulse",
  "tabs": [
    {
      "order": 0,
      "tab_id": "default",
      "title": "Overview",
      "tiles": [
        {
          "tile_id": "header",
          "type": "text",
          "text": "# Revenue Pulse\n**Synthetic demo data** for a fictional B2B software company, complete through **2026-09-30**.\n\nNet revenue = gross revenue minus discounts and refunds. Attainment = net revenue / target. Year-over-year compares the same filtered months one year earlier. Default view: Q3 2026."
        },
        {
          "tile_id": "kpi-net-revenue",
          "title": "Net Revenue",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "fixed",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "USD, vs same period last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-net-revenue"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-attainment",
          "title": "Target Attainment",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "fixed",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of target, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-attainment"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-variance",
          "title": "Variance to Target",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 0,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "fixed",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "USD, net revenue minus target"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-variance"
          ],
          "scope": "main"
        },
        {
          "tile_id": "kpi-margin",
          "title": "Gross Margin",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": true,
                  "sparklineColorMode": "fixed",
                  "seriesBucketField": "DS",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "SERIES_VALUE",
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of net revenue, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-margin"
          ],
          "scope": "main"
        },
        {
          "tile_id": "trend",
          "title": "Monthly Net Revenue vs Target (drag across months to zoom and filter)",
          "type": "chart",
          "spec": {
            "transform": [
              {
                "fold": [
                  "NET_REVENUE",
                  "REVENUE_TARGET"
                ],
                "as": [
                  "SERIES",
                  "VALUE"
                ]
              },
              {
                "calculate": "datum.SERIES === 'NET_REVENUE' ? 'Net revenue' : 'Target'",
                "as": "SERIES_LABEL"
              }
            ],
            "encoding": {
              "x": {
                "field": "MONTH",
                "type": "temporal",
                "title": "Month"
              },
              "y": {
                "field": "VALUE",
                "type": "quantitative",
                "title": "USD",
                "stack": null,
                "scale": {
                  "zero": false
                },
                "axis": {
                  "format": "$,.2s"
                }
              },
              "color": {
                "field": "SERIES_LABEL",
                "type": "nominal",
                "title": null,
                "scale": {
                  "domain": [
                    "Net revenue",
                    "Target"
                  ],
                  "range": [
                    "#4686fb",
                    "#f66b19"
                  ]
                }
              },
              "fillOpacity": {
                "condition": {
                  "test": "datum.SERIES === 'NET_REVENUE'",
                  "value": 0.3
                },
                "value": 0
              },
              "tooltip": [
                {
                  "field": "MONTH",
                  "type": "temporal",
                  "format": "%b %Y"
                },
                {
                  "field": "SERIES_LABEL",
                  "title": "Series"
                },
                {
                  "field": "VALUE",
                  "type": "quantitative",
                  "format": "$,.0f"
                }
              ]
            },
            "mark": {
              "type": "area",
              "interpolate": "monotone",
              "clip": true,
              "line": {
                "strokeWidth": 2.5
              },
              "point": true
            }
          },
          "datasources": [
            "ds-trend"
          ],
          "scope": "main",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "MONTH"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                },
                {
                  "scope": "heat",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                },
                {
                  "scope": "region",
                  "fields": [
                    "MONTH"
                  ],
                  "filter": "BRUSH_MONTH"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "by-region",
          "title": "Variance to Target by Region (click a region to drill the charts below)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "bar",
                  "cornerRadiusEnd": 3
                },
                "encoding": {
                  "y": {
                    "field": "DRILL_REGION",
                    "type": "nominal",
                    "sort": "x",
                    "title": null,
                    "axis": {
                      "labelExpr": "peek(split(datum.label, ' \u203a '))",
                      "labelLimit": 180
                    }
                  },
                  "x": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "USD vs target",
                    "axis": {
                      "format": "$,.2s"
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "color": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "scheme": {
                        "name": "turbo",
                        "extent": [
                          0.92,
                          0.1
                        ]
                      },
                      "domainMid": 0
                    },
                    "legend": null
                  },
                  "tooltip": [
                    {
                      "field": "LEVEL",
                      "title": "Level"
                    },
                    {
                      "field": "DRILL_REGION",
                      "title": "Path"
                    },
                    {
                      "field": "NET_REVENUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Net revenue"
                    },
                    {
                      "field": "REVENUE_TARGET",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Target"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Variance"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%",
                      "title": "Attainment"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "aggregate": [
                      {
                        "op": "min",
                        "field": "VARIANCE",
                        "as": "LO"
                      },
                      {
                        "op": "max",
                        "field": "VARIANCE",
                        "as": "HI"
                      }
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": "$,.2s",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "scheme": {
                        "name": "turbo",
                        "extent": [
                          0.92,
                          0.1
                        ]
                      },
                      "domainMid": 0
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-by-region"
          ],
          "scope": "region",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "DRILL_REGION"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "DRILL_REGION"
                  ],
                  "filter": "DRILL_REGION"
                },
                {
                  "scope": "heat",
                  "fields": [
                    "DRILL_REGION"
                  ],
                  "filter": "DRILL_REGION"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "heatmap",
          "title": "Target Attainment: Region x Segment",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "transform": [
                  {
                    "calculate": "datum.ATTAINMENT",
                    "as": "HEAT"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "min",
                        "field": "HEAT",
                        "as": "HEAT_LO"
                      },
                      {
                        "op": "max",
                        "field": "HEAT",
                        "as": "HEAT_HI"
                      }
                    ]
                  }
                ],
                "layer": [
                  {
                    "mark": {
                      "type": "rect",
                      "stroke": "black",
                      "strokeWidth": 2
                    },
                    "encoding": {
                      "color": {
                        "field": "HEAT",
                        "type": "quantitative",
                        "title": "Attainment",
                        "scale": {
                          "scheme": "turbo",
                          "reverse": true,
                          "domain": [
                            0.55,
                            1.2
                          ],
                          "clamp": true
                        },
                        "legend": null
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "text",
                      "fontWeight": "bold"
                    },
                    "encoding": {
                      "text": {
                        "field": "ATTAINMENT",
                        "type": "quantitative",
                        "format": ".1%"
                      },
                      "color": {
                        "condition": {
                          "test": "datum.ATTAINMENT < 0.68 || datum.ATTAINMENT > 1.12",
                          "value": "white"
                        },
                        "value": "#14365d"
                      }
                    }
                  }
                ],
                "encoding": {
                  "x": {
                    "field": "SEGMENT",
                    "type": "nominal",
                    "title": null,
                    "sort": [
                      "Enterprise",
                      "Mid-market",
                      "SMB"
                    ],
                    "axis": {
                      "labelAngle": 0
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "REGION",
                    "type": "nominal",
                    "title": null
                  },
                  "tooltip": [
                    {
                      "field": "REGION"
                    },
                    {
                      "field": "SEGMENT"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "calculate": "datum.ATTAINMENT",
                    "as": "HEAT"
                  },
                  {
                    "calculate": "0.55",
                    "as": "LO"
                  },
                  {
                    "calculate": "1.2",
                    "as": "HI"
                  },
                  {
                    "aggregate": [
                      {
                        "op": "count",
                        "as": "N"
                      }
                    ],
                    "groupby": [
                      "LO",
                      "HI"
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Attainment",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": ".0%",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "scheme": "turbo",
                      "reverse": true,
                      "domain": [
                        0.55,
                        1.2
                      ],
                      "clamp": true
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-heatmap"
          ],
          "scope": "heat",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "REGION",
                "SEGMENT"
              ],
              "operator": "set_filter",
              "targets": [
                {
                  "scope": "main",
                  "fields": [
                    "REGION"
                  ],
                  "filter": "REGION"
                },
                {
                  "scope": "main",
                  "fields": [
                    "SEGMENT"
                  ],
                  "filter": "SEGMENT"
                },
                {
                  "scope": "region",
                  "fields": [
                    "REGION"
                  ],
                  "filter": "REGION"
                },
                {
                  "scope": "region",
                  "fields": [
                    "SEGMENT"
                  ],
                  "filter": "SEGMENT"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "drivers",
          "title": "What Sales Ops Recorded: Variance by Driver (follows the region you click)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "bar",
                  "cornerRadiusEnd": 3
                },
                "encoding": {
                  "y": {
                    "field": "DRILL_DRIVER",
                    "type": "nominal",
                    "sort": "x",
                    "title": null,
                    "axis": {
                      "labelExpr": "split(replace(peek(split(datum.label, ' \u203a ')), 'RECORDED_', ''), '_')",
                      "labelLimit": 200,
                      "labelLineHeight": 13
                    }
                  },
                  "x": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "USD vs target",
                    "axis": {
                      "format": "$,.2s"
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "color": {
                    "field": "VARIANCE",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "scheme": {
                        "name": "turbo",
                        "extent": [
                          0.92,
                          0.1
                        ]
                      },
                      "domainMid": 0
                    },
                    "legend": null
                  },
                  "tooltip": [
                    {
                      "field": "LEVEL",
                      "title": "Level"
                    },
                    {
                      "field": "DRILL_DRIVER",
                      "title": "Path"
                    },
                    {
                      "field": "VARIANCE",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "DISCOUNTS",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "REFUNDS",
                      "type": "quantitative",
                      "format": "$,.0f"
                    },
                    {
                      "field": "ACCOUNTS",
                      "type": "quantitative",
                      "title": "Accounts"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "aggregate": [
                      {
                        "op": "min",
                        "field": "VARIANCE",
                        "as": "LO"
                      },
                      {
                        "op": "max",
                        "field": "VARIANCE",
                        "as": "HI"
                      }
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Variance",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": "$,.2s",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "scheme": {
                        "name": "turbo",
                        "extent": [
                          0.92,
                          0.1
                        ]
                      },
                      "domainMid": 0
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-drivers"
          ],
          "scope": "detail"
        },
        {
          "tile_id": "waterfall",
          "title": "Variance Bridge: How Each Recorded Driver Moves Us vs Target",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "layer": [
                  {
                    "mark": {
                      "type": "bar",
                      "width": {
                        "band": 0.6
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "START_VALUE",
                        "type": "quantitative",
                        "title": "USD vs target",
                        "axis": {
                          "format": "$,.2s"
                        }
                      },
                      "y2": {
                        "field": "END_VALUE"
                      },
                      "color": {
                        "field": "AMOUNT",
                        "type": "quantitative",
                        "title": "Amount",
                        "scale": {
                          "scheme": {
                            "name": "turbo",
                            "extent": [
                              0.92,
                              0.1
                            ]
                          },
                          "domainMid": 0
                        },
                        "legend": null
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "rule",
                      "color": "#8a9bb0"
                    },
                    "encoding": {
                      "y": {
                        "datum": 0
                      }
                    }
                  },
                  {
                    "transform": [
                      {
                        "filter": "datum.KIND !== 'Total'"
                      }
                    ],
                    "mark": {
                      "type": "rule",
                      "strokeDash": [
                        3,
                        3
                      ],
                      "color": "#8a9bb0",
                      "xOffset": {
                        "expr": "bandwidth('x') * 0.3"
                      },
                      "x2Offset": {
                        "expr": "-bandwidth('x') * 0.3"
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "END_VALUE",
                        "type": "quantitative"
                      },
                      "x2": {
                        "field": "NEXT_STEP"
                      }
                    }
                  },
                  {
                    "mark": {
                      "type": "text",
                      "fontSize": 11,
                      "color": "#8a9bb0",
                      "dy": {
                        "expr": "datum.AMOUNT < 0 ? 10 : -8"
                      }
                    },
                    "encoding": {
                      "y": {
                        "field": "LABEL_Y",
                        "type": "quantitative"
                      },
                      "text": {
                        "field": "AMOUNT",
                        "type": "quantitative",
                        "format": "$,.3s"
                      }
                    }
                  }
                ],
                "encoding": {
                  "x": {
                    "field": "STEP",
                    "type": "nominal",
                    "title": null,
                    "sort": {
                      "field": "STEP_ORDER"
                    },
                    "axis": {
                      "labelAngle": 0,
                      "labelOverlap": false,
                      "labelLineHeight": 14,
                      "labelExpr": "[substring(datum.label, 0, indexof(datum.label, ' ')), substring(datum.label, indexof(datum.label, ' ') + 1)]"
                    },
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 28"
                        }
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "STEP",
                      "title": "Step"
                    },
                    {
                      "field": "AMOUNT",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Amount"
                    },
                    {
                      "field": "END_VALUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Running variance"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "aggregate": [
                      {
                        "op": "min",
                        "field": "AMOUNT",
                        "as": "LO"
                      },
                      {
                        "op": "max",
                        "field": "AMOUNT",
                        "as": "HI"
                      }
                    ]
                  },
                  {
                    "calculate": "sequence(0, 50)",
                    "as": "I"
                  },
                  {
                    "flatten": [
                      "I"
                    ]
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * datum.I / 50",
                    "as": "V"
                  },
                  {
                    "calculate": "datum.LO + (datum.HI - datum.LO) * (datum.I + 1) / 50",
                    "as": "V2"
                  }
                ],
                "mark": {
                  "type": "rect"
                },
                "encoding": {
                  "x": {
                    "datum": 0,
                    "axis": null,
                    "scale": {
                      "domain": [
                        0,
                        1
                      ],
                      "range": [
                        {
                          "expr": "width - 14"
                        },
                        {
                          "expr": "width"
                        }
                      ]
                    }
                  },
                  "x2": {
                    "datum": 1
                  },
                  "y": {
                    "field": "V",
                    "type": "quantitative",
                    "title": "Amount",
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.85"
                        },
                        {
                          "expr": "height * 0.15"
                        }
                      ]
                    },
                    "axis": {
                      "orient": "right",
                      "offset": 4,
                      "format": "$,.2s",
                      "tickCount": 4,
                      "grid": false,
                      "domain": false,
                      "titleAngle": 90
                    }
                  },
                  "y2": {
                    "field": "V2"
                  },
                  "color": {
                    "field": "V",
                    "type": "quantitative",
                    "scale": {
                      "scheme": {
                        "name": "turbo",
                        "extent": [
                          0.92,
                          0.1
                        ]
                      },
                      "domainMid": 0
                    },
                    "legend": null
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "x": "independent",
                "y": "independent",
                "color": "independent"
              },
              "axis": {
                "x": "independent",
                "y": "independent"
              }
            }
          },
          "datasources": [
            "ds-waterfall"
          ],
          "scope": "main"
        },
        {
          "tile_id": "bubble",
          "title": "Accounts: Target vs Attainment (bubble size = net revenue)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "rule",
                  "strokeDash": [
                    4,
