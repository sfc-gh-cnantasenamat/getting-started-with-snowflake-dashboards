    "ds-by-region": {
      "type": "sql",
      "columns": [
        {
          "name": "DRILL_REGION",
          "type": "VARCHAR"
        },
        {
          "name": "LEVEL",
          "type": "VARCHAR"
        },
        {
          "name": "NET_REVENUE",
          "type": "NUMBER"
        },
        {
          "name": "REVENUE_TARGET",
          "type": "NUMBER"
        },
        {
          "name": "VARIANCE",
          "type": "NUMBER"
        },
        {
          "name": "ATTAINMENT",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH f AS (\n    SELECT * FROM (SELECT *, REGION AS DRILL_REGION_1, REGION || ' \u203a ' || SEGMENT AS DRILL_REGION_2, REGION || ' \u203a ' || SEGMENT || ' \u203a ' || CUSTOMER_NAME AS DRILL_REGION_3, RECORDED_DRIVER AS DRILL_DRIVER_1, RECORDED_DRIVER || ' \u203a ' || CUSTOMER_NAME AS DRILL_DRIVER_2 FROM (\n    SELECT MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name, revenue.recorded_driver, customers.customer_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds)))\n    WHERE ({{ filter('MONTH') }} OR EXISTS (SELECT 1 FROM (SELECT DATE '1900-01-01' AS MONTH) WHERE NOT ({{ filter('BRUSH_MONTH', 'MONTH') }})))\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n    AND {{ filter('BRUSH_MONTH', 'MONTH') }}\n    AND ({{ filter('DRILL_REGION', 'DRILL_REGION_1') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_2') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_3') }})\n    AND ({{ filter('DRILL_DRIVER', 'DRILL_DRIVER_1') }} OR {{ filter('DRILL_DRIVER', 'DRILL_DRIVER_2') }})\n),\nlvl AS (SELECT CASE WHEN NOT (EXISTS (SELECT 1 FROM (SELECT '\u00a7' AS DRILL_REGION_1, '\u00a7' AS DRILL_REGION_2, '\u00a7' AS DRILL_REGION_3) WHERE NOT ({{ filter('DRILL_REGION', 'DRILL_REGION_1') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_2') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_3') }})) OR EXISTS (SELECT 1 FROM (SELECT '\u00a7' AS REGION) WHERE NOT ({{ filter('REGION', 'REGION') }})) OR EXISTS (SELECT 1 FROM (SELECT '\u00a7' AS SEGMENT) WHERE NOT ({{ filter('SEGMENT', 'SEGMENT') }}))) THEN 1 WHEN COUNT(DISTINCT DRILL_REGION_1) > 1 THEN 1 WHEN COUNT(DISTINCT DRILL_REGION_2) > 1 THEN 2 ELSE 3 END AS L FROM f)\nSELECT CASE L WHEN 1 THEN DRILL_REGION_1 WHEN 2 THEN DRILL_REGION_2 WHEN 3 THEN DRILL_REGION_3 END AS DRILL_REGION, DECODE(L, 1, 'Region', 2, 'Segment', 3, 'Account') AS LEVEL,\n    SUM(NET_REVENUE) AS NET_REVENUE, SUM(REVENUE_TARGET) AS REVENUE_TARGET,\n    SUM(NET_REVENUE) - SUM(REVENUE_TARGET) AS VARIANCE,\n    DIV0NULL(SUM(NET_REVENUE), SUM(REVENUE_TARGET)) AS ATTAINMENT\nFROM f CROSS JOIN lvl\nGROUP BY 1, L\nORDER BY VARIANCE",
      "filter_bindings": [
        {
          "filter_id": "MONTH"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "SEGMENT"
