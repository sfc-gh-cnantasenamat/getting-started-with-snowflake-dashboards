                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "calculate": "time(toDate(datum['DS']))",
                    "as": "__sx"
                  },
                  {
                    "joinaggregate": [
                      {
                        "op": "max",
                        "field": "__sx",
                        "as": "__sxmax"
                      }
                    ]
                  },
                  {
                    "calculate": "datum.__sx == datum.__sxmax ? [0, 1] : [0]",
                    "as": "__tail"
                  },
                  {
                    "flatten": [
                      "__tail"
                    ]
                  }
                ],
                "mark": {
                  "type": "line",
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "opacity": 0.36,
                  "strokeWidth": 1,
                  "strokeCap": "round",
                  "strokeJoin": "round",
                  "interpolate": "monotone",
                  "xOffset": {
                    "expr": "datum.__tail == 1 ? 3 : 0"
                  },
                  "clip": {
                    "signal": "pathShape('M-2,-2H' + (__scorecard_reveal >= 1 ? width + 2 : __scorecard_reveal * width) + 'V' + (height + 2) + 'H-2Z')"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "__sx",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__last"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "descending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__last == 1"
                  }
                ],
                "mark": {
                  "type": "point",
                  "filled": false,
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "strokeWidth": 1,
                  "clip": true,
                  "size": {
                    "expr": "__scorecard_pulse <= 0 || __scorecard_pulse >= 1 ? 0 : pow(14 * (1 + 1.6 * (1 - pow(1 - __scorecard_pulse, 2))), 2)"
                  },
                  "strokeOpacity": {
                    "expr": "__scorecard_pulse <= 0 || __scorecard_pulse >= 1 ? 0 : 1 - __scorecard_pulse"
                  }
                },
                "encoding": {
                  "x": {
                    "field": "DS",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "transform": [
                  {
                    "filter": "isValid(datum['SERIES_VALUE']) && isFinite(toNumber(datum['SERIES_VALUE']))"
                  },
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__last"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "descending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__last == 1"
                  }
                ],
                "mark": {
                  "type": "point",
                  "filled": true,
                  "opacity": 1,
                  "color": {
                    "expr": "datum['__lineColor']"
                  },
                  "size": 36,
                  "clip": true,
                  "tooltip": true
                },
                "encoding": {
                  "x": {
                    "field": "DS",
                    "type": "temporal",
                    "axis": null,
                    "scale": {
                      "range": [
                        0,
                        {
                          "expr": "width - 3"
                        }
                      ]
                    }
                  },
                  "y": {
                    "field": "SERIES_VALUE",
                    "type": "quantitative",
                    "axis": null,
                    "stack": null,
                    "scale": {
                      "zero": false,
                      "nice": false,
                      "range": [
                        {
                          "expr": "height * 0.74"
                        },
                        {
                          "expr": "height * 0.14"
                        }
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "DS",
                      "type": "temporal",
                      "format": "%b %d, %Y"
                    },
                    {
                      "field": "SERIES_VALUE",
                      "type": "quantitative"
                    }
                  ]
                }
              },
              {
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  }
                ],
                "mark": {
                  "type": "text",
                  "align": "center",
                  "baseline": "middle",
                  "fontWeight": "bold",
                  "fontSize": {
                    "expr": "width >= 140 ? 40 : (width >= 90 ? 24 : 14)"
                  },
                  "limit": {
                    "expr": "width - 8"
                  },
                  "color": {
                    "expr": "datum['__numberColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "width / 2"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20"
                    }
                  },
                  "text": {
                    "field": "bigNumberText"
                  }
                }
              },
              {
                "name": "scorecard-trend-icon-up",
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
                    "sort": [
                      {
                        "field": "DS",
                        "order": "ascending"
                      }
                    ]
                  },
                  {
                    "filter": "datum.__row == 1"
                  },
                  {
                    "calculate": "datum['deltaDirection'] == '' ? 0 : 16",
                    "as": "__iw"
                  },
                  {
                    "calculate": "scorecardTextWidth(datum['deltaText'], '600 12px Inter, Roboto, \\'Helvetica Neue\\', Arial, sans-serif')",
                    "as": "__dw"
                  },
                  {
                    "calculate": "0",
                    "as": "__cw"
                  },
                  {
                    "calculate": "max(4, width / 2 - (datum.__iw + datum.__dw + (datum.__cw > 0 ? 6 + datum.__cw : 0)) / 2)",
                    "as": "__ix"
                  },
                  {
                    "calculate": "datum.__ix + datum.__iw",
                    "as": "__dx"
                  },
                  {
                    "filter": "datum['deltaDirection'] == 'up'"
                  }
                ],
                "mark": {
                  "type": "point",
                  "shape": "M4.05 9.72a.5.5 0 0 1 .055-.527l3.5-4.5a.5.5 0 0 1 .79 0l3.5 4.5A.5.5 0 0 1 11.5 10h-7a.5.5 0 0 1-.45-.28",
                  "size": 4,
                  "filled": true,
                  "opacity": 1,
                  "strokeWidth": 0,
                  "color": {
                    "expr": "datum['deltaColor']"
                  }
                },
                "encoding": {
                  "x": {
                    "value": {
                      "expr": "datum.__ix"
                    }
                  },
                  "y": {
                    "value": {
                      "expr": "(height + 28) / 2 - 20 + 54 - 8"
                    }
                  }
                }
              },
              {
                "name": "scorecard-trend-icon-down",
                "transform": [
                  {
                    "window": [
                      {
                        "op": "row_number",
                        "as": "__row"
                      }
                    ],
