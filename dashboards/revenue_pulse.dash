    "ds-waterfall": {
      "type": "sql",
      "columns": [
        {
          "name": "STEP_ORDER",
          "type": "NUMBER"
        },
        {
          "name": "STEP",
          "type": "VARCHAR"
        },
        {
          "name": "KIND",
          "type": "VARCHAR"
        },
        {
          "name": "START_VALUE",
          "type": "NUMBER"
        },
        {
          "name": "END_VALUE",
          "type": "NUMBER"
        },
        {
          "name": "AMOUNT",
          "type": "NUMBER"
        },
        {
          "name": "LABEL_Y",
          "type": "NUMBER"
        },
        {
          "name": "NEXT_STEP",
          "type": "VARCHAR"
        }
      ],
      "sql": "WITH d AS (\n    SELECT RECORDED_DRIVER, SUM(NET_REVENUE) - SUM(REVENUE_TARGET) AS V\n    FROM (SELECT *, REGION AS DRILL_REGION_1, REGION || ' \u203a ' || SEGMENT AS DRILL_REGION_2, REGION || ' \u203a ' || SEGMENT || ' \u203a ' || CUSTOMER_NAME AS DRILL_REGION_3, RECORDED_DRIVER AS DRILL_DRIVER_1, RECORDED_DRIVER || ' \u203a ' || CUSTOMER_NAME AS DRILL_DRIVER_2 FROM (\n    SELECT MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name, revenue.recorded_driver, customers.customer_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds)))\n    WHERE ({{ filter('MONTH') }} OR EXISTS (SELECT 1 FROM (SELECT DATE '1900-01-01' AS MONTH) WHERE NOT ({{ filter('BRUSH_MONTH', 'MONTH') }})))\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n    AND {{ filter('BRUSH_MONTH', 'MONTH') }}\n    AND ({{ filter('DRILL_REGION', 'DRILL_REGION_1') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_2') }} OR {{ filter('DRILL_REGION', 'DRILL_REGION_3') }})\n    AND ({{ filter('DRILL_DRIVER', 'DRILL_DRIVER_1') }} OR {{ filter('DRILL_DRIVER', 'DRILL_DRIVER_2') }})\n    GROUP BY RECORDED_DRIVER\n),\nsteps AS (\n    SELECT ROW_NUMBER() OVER (ORDER BY V DESC) AS STEP_ORDER,\n        DECODE(RECORDED_DRIVER, 'NORMAL_TRADING', 'Normal trading', 'RECORDED_RENEWAL_DELAY', 'Renewal delay',\n            'RECORDED_CONTRACT_DOWNSIZE', 'Contract downsize', 'RECORDED_DISCOUNT_AND_SERVICE_CREDIT', 'Discounts & credits',\n            RECORDED_DRIVER) AS STEP,\n        IFF(V < 0, 'Decrease', 'Increase') AS KIND,\n        COALESCE(SUM(V) OVER (ORDER BY V DESC ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), 0) AS START_VALUE,\n        SUM(V) OVER (ORDER BY V DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS END_VALUE,\n        V AS AMOUNT\n    FROM d\n    UNION ALL\n    SELECT 99, 'Total variance', 'Total', 0, SUM(V), SUM(V) FROM d\n)\nSELECT STEP_ORDER, STEP, KIND, START_VALUE, END_VALUE, AMOUNT,\n    IFF(AMOUNT < 0, LEAST(START_VALUE, END_VALUE), GREATEST(START_VALUE, END_VALUE)) AS LABEL_Y,\n    LEAD(STEP) OVER (ORDER BY STEP_ORDER) AS NEXT_STEP\nFROM steps\nORDER BY STEP_ORDER",
      "filter_bindings": [
        {
          "filter_id": "MONTH"
        },
        {
          "filter_id": "BRUSH_MONTH"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "SEGMENT"
        },
        {
          "filter_id": "PRODUCT_NAME"
        },
        {
          "filter_id": "DRILL_REGION"
        },
        {
          "filter_id": "DRILL_DRIVER"
        }
      ]
    },
